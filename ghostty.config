# Ghostty terminal config, symlinked to ~/.config/ghostty/config by setup.sh.
#
# Ghostty has no preferences GUI - this file is it.
#
# To reload config in a running terminal window without restarting it:
#
#   cmd+shift+,
#
# Every option, with its docs and default:
#
#   ghostty +show-config --default --docs
#   ghostty +list-themes / +list-fonts / +list-keybinds / +list-actions
#
# What actually resolved once this file is applied - the way to check a
# setting took effect, rather than assuming it did:
#
#   ghostty +show-config

# --- Appearance ---------------------------------------------------------------

# A light and a dark theme, automatically follows the macOS appearance
theme = dark:Kanso Ink,light:Kanso Pearl

# Ghostty embeds Symbols Nerd Font and falls back to it for any glyph the main
# font lacks, so starship's icons render without a patched Nerd Font being
# installed. That's why this can be a plain font and not a patched one.
font-family = "Source Code Pro for Powerline"
font-size = 14

window-padding-x = 8
window-padding-y = 4

# --- macOS --------------------------------------------------------------------

# Put tabs in the titlebar rather than on their own row beneath it.
macos-titlebar-style = tabs

# --- Keybinds -----------------------------------------------------------------

# Resizing a split re-wraps the scrollback, which wrecks the history of any
# program that drew itself at the old width - Claude Code, lazygit, vim. Those
# programs emit hard newlines at layout time, so the terminal cannot tell
# formatting from content and cannot undo it. Nothing prevents that, so this is
# the way out: dump the buffer to a plain text file and open it, where terminal
# geometry no longer applies.
keybind = cmd+shift+s=write_scrollback_file:open,plain

# cmd+k is `clear_screen`, which clears the scrollback as well as the screen.
# Terminal.app and iTerm2 do this but I don't like that history can be deleted
# and it can't be undone.
#
# ctrl+l already clears the screen without touching scrollback (that's zsh's own
# clear-screen, not Ghostty), and "Clear Screen" is still in the cmd+shift+p menu
# if it is actually wanted.
keybind = cmd+k=unbind
