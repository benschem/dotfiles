# To reload config:
#
#   cmd+shift+,
#
# Commands:
#
#   ghostty +show-config --default --docs
#   ghostty +list-themes / +list-fonts / +list-keybinds / +list-actions
#   ghostty +show-config

theme = dark:Wez,light:Wez

font-family = "Menlo"
font-size = 14

window-padding-x = 8
window-padding-y = 4

macos-titlebar-style = tabs

# Both Option keys send Alt, so zsh's Alt shortcuts work, such as Alt+. for the
# previous command's last argument. Option can't type £, – or é in Ghostty.
macos-option-as-alt = true

# Dump buffer to plain text file and open it to read resized scrollback
keybind = cmd+shift+s=write_scrollback_file:open,plain

# Show/hide Ghostty from anywhere, without it needing focus first. `global:`
# registers the shortcut with macOS rather than the terminal, so it fires even
# when another app is frontmost.
keybind = global:ctrl+grave_accent=toggle_visibility

# Unbind clear_screen, to not accidentally clear the scrollback => use ctrl+l instead
keybind = cmd+k=unbind
