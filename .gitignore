# Ignores for THIS repo only.
#
# Machine-wide junk (.DS_Store, tool caches) lives in .gitignore_global, which
# is symlinked to ~/.gitignore_global and applies everywhere. Everything below
# is specific to the dotfiles repo, which is why it isn't in that file: these
# paths only exist here because parts of ~ get symlinked back into the repo.

# Server aliases and connection details
.ssh/config

# Claude Code secrets and state, in case more of ~/.claude ever gets symlinked in
.claude/.credentials.json
.claude/history.jsonl
.claude/projects/
.claude/sessions/
